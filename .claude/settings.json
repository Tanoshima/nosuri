{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git branch -D*)",
      "Bash(git checkout --*)",
      "Bash(git checkout -- *)",
      "Bash(git restore --*)",
      "Bash(git clean -f*)",
      "Bash(git clean -fd*)",
      "Bash(git tag -d*)",
      "Bash(git update-ref*)",
      "Bash(git commit --amend*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit --no-gpg-sign*)",
      "Bash(git -c commit.gpgsign=false*)",
      "Bash(git cherry-pick*)",
      "Bash(git revert*)",
      "Bash(gh pr close*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr review --approve*)",
      "Bash(gh issue close*)",
      "Bash(gh release create*)",
      "Bash(gh repo delete*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api -X PUT*)",
      "Bash(gh api -X POST*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh api --method PUT*)",
      "Bash(gh api --method POST*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(dd *)",
      "Bash(find * -delete)",
      "Bash(pkill *)",
      "Bash(kill *)",
      "Bash(killall *)"
    ]
  }
}
